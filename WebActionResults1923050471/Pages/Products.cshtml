@page
@model WebActionResults1923050471.Pages.ProductsModel
@{
    ViewData["Title"] = "Products";
}

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Products</h2>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.Products)
            {
                <div class="col-12 col-sm-6 col-md-4">
                    <a href="/Product" style="text-decoration: none; color: inherit;">
                        <div class="card h-100" style="border: 1px solid #E4E7ED; border-radius: 6px;">
                            <div class="card-body d-flex flex-column align-items-center">
                                <div style="width: 100%; max-width: 220px; aspect-ratio: 1 / 1; background-color: #FBFBFC; border: 1px solid #E4E7ED; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: #8D99AE; font-weight: 600;">Image</span>
                                </div>
                                <h5 class="mt-3 mb-1 text-center">@product.Name</h5>
                                <div style="color: #D10024; font-weight: 700;">$@product.Price.ToString("F2")</div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <div class="row mt-4">
            <div class="col-12 d-flex justify-content-center gap-2">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    var buttonClass = pageNumber == Model.PageNumber ? "btn btn-danger" : "btn btn-outline-danger";
                    <a class="@buttonClass" href="/Products?page=@pageNumber">@pageNumber</a>
                }
            </div>
        </div>
    </div>
</div>
