@page
@{
    ViewData["Title"] = "Cart";
}

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Cart</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card" style="border: 1px solid #E4E7ED; border-radius: 6px;">
                    <div class="card-body">
                        @for (var i = 1; i <= 3; i++)
                        {
                            <div class="d-flex align-items-center justify-content-between border-bottom py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div style="width: 96px; height: 96px; background-color: #FBFBFC; border: 1px solid #E4E7ED; display: flex; align-items: center; justify-content: center;">
                                        <span style="color: #8D99AE; font-weight: 600;">Image</span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Cart Item @i</h5>
                                        <div class="text-muted">Qty: @(i)</div>
                                    </div>
                                </div>
                                <div style="color: #D10024; font-weight: 700;">$@((i * 199).ToString("F2"))</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card" style="border: 1px solid #E4E7ED; border-radius: 6px;">
                    <div class="card-body">
                        <h5 class="mb-3">Summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@((3 * 199).ToString("F2"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Shipping</span>
                            <span>$15.00</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold mb-4">
                            <span>Total</span>
                            <span>$@((3 * 199 + 15).ToString("F2"))</span>
                        </div>
                        <button type="button" class="btn btn-danger w-100">Checkout</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
