@page
@{
    ViewData["Title"] = "Wishlist";
}

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-4">Wishlist</h2>
            </div>
        </div>
        <div class="row g-4">
            @for (var i = 1; i <= 6; i++)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100" style="border: 1px solid #E4E7ED; border-radius: 6px;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-3">
                                <div style="width: 96px; height: 96px; background-color: #FBFBFC; border: 1px solid #E4E7ED; display: flex; align-items: center; justify-content: center;">
                                    <span style="color: #8D99AE; font-weight: 600;">Image</span>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">Wishlist Item @i</h5>
                                    <div style="color: #D10024; font-weight: 700;">$@((i * 125).ToString("F2"))</div>
                                </div>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <a href="/Product" class="btn btn-outline-danger btn-sm">View</a>
                                <button type="button" class="btn btn-danger btn-sm">Move to Cart</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
