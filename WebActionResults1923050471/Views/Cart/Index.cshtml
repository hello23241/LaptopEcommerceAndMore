@model WebActionResults1923050471.ViewModels.ShoppingCart

@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1 class="mb-4">Shopping Cart</h1>

    @if (Model?.Items != null && Model.Items.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>$@item.Price.ToString("F2")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" style="display: inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width: 80px; display: inline-block;" />
                                    <button type="submit" class="btn btn-sm btn-info">Update</button>
                                </form>
                            </td>
                            <td>$@item.Subtotal.ToString("F2")</td>
                            <td>
                                <form asp-action="RemoveFromCart" method="post" style="display: inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row mt-4">
            <div class="col-md-8"></div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Cart Summary</h5>
                        <p class="card-text">
                            <strong>Total Items:</strong> @Model.TotalItems<br />
                            <strong>Total Price:</strong> <span style="font-size: 1.3em; color: #28a745;">$@Model.TotalPrice.ToString("F2")</span>
                        </p>
                    </div>
                </div>
                
                <div class="mt-3">
                    <form asp-action="Checkout" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-success btn-lg w-100">Proceed to Checkout</button>
                    </form>
                    <form asp-action="ClearCart" method="post" style="display: inline;">
                        <button type="submit" class="btn btn-warning w-100 mt-2" onclick="return confirm('Clear entire cart?')">Clear Cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            Your cart is empty. <a href="@Url.Action("Index", "Product")">Continue shopping</a>
        </div>
    }

    <a href="@Url.Action("Index", "Product")" class="btn btn-secondary mt-3">Continue Shopping</a>
</div>
