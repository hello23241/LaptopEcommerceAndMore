@model List<WebActionResults1923050471.Models.Brands>

@{
    ViewData["Title"] = "Suppliers";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userName = Context.Session.GetString("UserName");
    var isAdmin = userName == "admin";
}

<div class="container mt-4">
    <h1 class="mb-4">Suppliers</h1>

    @if (isAdmin)
    {
        <a href="@Url.Action("Create")" class="btn btn-primary mb-3">Add New Supplier</a>
    }

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>Address</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var supplier in Model)
                {
                    <tr>
                        <td>@supplier.BrandId</td>
                        <td>@supplier.BrandName</td>
                        <td>@supplier.ContactInfo</td>
                        <td>@supplier.Address</td>
                        <td>
                            <a href="@Url.Action("Details", new { id = supplier.BrandId })" class="btn btn-sm btn-info">View</a>
                            <a href="@Url.Action("Edit", new { id = supplier.BrandId })" class="btn btn-sm btn-warning">Edit</a>
                            <a href="@Url.Action("Delete", new { id = supplier.BrandId })" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No suppliers found. <a href="@Url.Action("Create")">Create one</a></div>
    }
</div>
