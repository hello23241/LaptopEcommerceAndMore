@model List<WebActionResults1923050471.Models.Products>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var isAdmin = userName == "admin";
}

<div class="container mt-4">
    <h1 class="mb-4">Products</h1>

    @if (isAdmin)
    {
        <a href="@Url.Action("Create")" class="btn btn-primary mb-3">Add New Product</a>
    }

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.ProductID</td>
                        <td>@product.ProductName</td>
                        <td>$@product.BasePrice.ToString("F2")</td>
                        <td>@product.CategoryID</td>
                        <td>
                            <a href="@Url.Action("Details", new { id = product.ProductID })" class="btn btn-sm btn-info">View</a>
                            <a href="@Url.Action("Edit", new { id = product.ProductID })" class="btn btn-sm btn-warning">Edit</a>
                            <a href="@Url.Action("Delete", new { id = product.ProductID })" class="btn btn-sm btn-danger">Delete</a>
                            @await Component.InvokeAsync("CompareButton", new { productId = product.ProductID })
                            @if (userId.HasValue)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" style="display: inline;">
                                    <input type="hidden" name="productId" value="@product.ProductID" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-sm btn-success">Add to Cart</button>
                                </form>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path + Context.Request.QueryString })" class="btn btn-sm btn-outline-success">Add to Cart</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No products found. <a href="@Url.Action("Create")">Create one</a></div>
    }
</div>
