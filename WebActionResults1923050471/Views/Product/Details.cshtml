@model WebActionResults1923050471.Models.ProductDetailsViewModel

@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>@Model.Product.Name</h1>
    
    <div class="card">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Product.Id</p>
            <p><strong>Description:</strong> @Model.Product.Description</p>
            <p><strong>Price:</strong> $@Model.Product.Price.ToString("F2")</p>
            <p><strong>Quantity:</strong> @Model.Product.Quantity</p>
            <p><strong>Category ID:</strong> @Model.Product.CategoryId</p>
            <p><strong>Supplier ID:</strong> @Model.Product.SupplierId</p>
            <div class="mt-3">
                @await Component.InvokeAsync("CompareButton", new { productId = Model.Product.Id })
            </div>
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-body">
            <ul class="nav nav-tabs" role="tablist">
                @for (var index = 0; index < Model.Tabs.Count; index++)
                {
                    var tab = Model.Tabs[index];
                    var isActive = index == 0;
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isActive ? "active" : "")" id="tab-@index" data-bs-toggle="tab" data-bs-target="#tab-content-@index" type="button" role="tab" aria-controls="tab-content-@index" aria-selected="@(isActive ? "true" : "false")">@tab.Title</button>
                    </li>
                }
            </ul>
            <div class="tab-content pt-3">
                @for (var index = 0; index < Model.Tabs.Count; index++)
                {
                    var tab = Model.Tabs[index];
                    var isActive = index == 0;
                    <div class="tab-pane fade @(isActive ? "show active" : "")" id="tab-content-@index" role="tabpanel" aria-labelledby="tab-@index">
                        <p>@tab.Content</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <a href="@Url.Action("Edit", new { id = Model.Product.Id })" class="btn btn-warning mt-3">Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back to List</a>
</div>
