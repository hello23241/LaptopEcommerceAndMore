@model WebActionResults1923050471.Models.Categories

@{
    ViewData["Title"] = "Category Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>@Model.CategoryName</h1>
    
    <div class="card">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.CategoryId</p>
            <p><strong>Description:</strong> @Model.Description</p>
        </div>
    </div>

    <a href="@Url.Action("Edit", new { id = Model.CategoryId })" class="btn btn-warning mt-3">Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back to List</a>
</div>
