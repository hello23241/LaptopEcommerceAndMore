@model WebActionResults1923050471.Models.Users

@{
    ViewData["Title"] = "Delete Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>Delete Account</h1>

    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this account?</h4>
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Username:</strong> @Model.Username</p>
            <p><strong>Full Name:</strong> @Model.FullName</p>
            <p><strong>Email:</strong> @Model.Email</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    </form>
</div>
