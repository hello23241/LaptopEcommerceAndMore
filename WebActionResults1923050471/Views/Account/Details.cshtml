@model WebActionResults1923050471.Models.Account

@{
    ViewData["Title"] = "Account Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>@Model.FullName</h1>

    <div class="card mt-3">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Username:</strong> @Model.UserName</p>
            <p><strong>Full Name:</strong> @Model.FullName</p>
            <p><strong>Email:</strong> @Model.Email</p>
            <p><strong>Phone:</strong> @Model.Phone</p>
            @if (Model.Birthday.HasValue)
            {
                <p><strong>Birthday:</strong> @Model.Birthday.Value.ToString("dd/MM/yyyy")</p>
            }
            <p><strong>Status:</strong>
                @if (Model.Status == 1)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </p>
        </div>
    </div>

    <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning mt-3">Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back to List</a>
</div>
