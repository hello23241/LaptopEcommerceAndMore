@model WebActionResults1923050471.Models.Users

@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>Profile - @Model.FullName</h1>

            <div class="card mt-3">
                <div class="card-body">
                    <p><strong>Username:</strong> @Model.Username</p>
                    <p><strong>Full Name:</strong> @Model.FullName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                    <p><strong>Status:</strong>
                        @if (Model.Role == "Customer")
                        {
                            <span class="badge bg-success">Customer</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                    </p>
                </div>
            </div>

            <div class="mt-3">
                <a href="@Url.Action("Edit", new { id = Model.UserId })" class="btn btn-warning">Edit Profile</a>
                <a href="@Url.Action("Logout")" class="btn btn-danger">Logout</a>
                <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">Back to Shop</a>
            </div>
        </div>
    </div>
</div>
