@model LaptopEcommerceAndMore.ViewComponents.HeaderBadgesViewModel

<div>
    <a href="/Account/Wishlist">
        <i class="fa fa-heart-o"></i>
        <span>Your Wishlist</span>
        @if (Model.WishlistCount > 0)
        {
            <div class="qty">@Model.WishlistCount</div>
        }
    </a>
</div>
<div class="dropdown">
    <a class="dropdown-toggle" data-toggle="dropdown" aria-expanded="true" href="/Cart/Cart" style="cursor:pointer">
        <i class="fa fa-shopping-cart"></i>
        <span>Your Cart</span>
        @if (Model.CartCount > 0)
        {
            <div class="qty">@Model.CartCount</div>
        }
    </a>
</div>