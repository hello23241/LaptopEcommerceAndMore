@model LaptopEcommerceAndMore.Models.Brands

@{
    ViewData["Title"] = "Supplier Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>@Model.BrandName</h1>
    
    <div class="card">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.BrandId</p>
        </div>
    </div>

    <a href="@Url.Action("Edit", new { id = Model.BrandId })" class="btn btn-warning mt-3">Edit</a>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back to List</a>
</div>

