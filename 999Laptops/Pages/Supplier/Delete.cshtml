@model LaptopEcommerceAndMore.Models.Brands

@{
    ViewData["Title"] = "Delete Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1>Delete Supplier</h1>

    <div class="alert alert-warning">
        <h4>Are you sure you want to delete this supplier?</h4>
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Name:</strong> @Model.BrandName</p>
        </div>
    </div>

    <form asp-action="Delete" method="post" class="mt-3">
        <input type="hidden" asp-for="BrandId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
    </form>
</div>

