@page
@model LaptopEcommerceAndMore.Pages.CartModel
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="section">
    <div class="container">
        <h1 class="mb-4">Shopping Cart</h1>

        @if (Model.Cart?.Items != null && Model.Cart.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th style="width: 150px;">Quantity</th>
                            <th>Subtotal</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Cart.Items)
                        {
                            <tr>
                                <td>
                                    <a href="/ProductDetail/@item.ProductId"
                                           style="text-decoration: none; color: #1E1F29; font-weight: 600; transition: color 0.2s ease-in-out;"
                                           onmouseover="this.style.color='#D10024'"
                                           onmouseout="this.style.color='#1E1F29'">
                                        @item.ProductName
                                    </a>
                                </td>
                                <td>$@item.Price.ToString("F2")</td>
                                <td>
                                    <form method="post" asp-page-handler="UpdateQuantity" class="d-flex gap-2">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" />
                                        <button type="submit" class="btn btn-sm btn-info">Update</button>
                                    </form>
                                </td>
                                <td>$@((item.Price * item.Quantity).ToString("F2"))</td>
                                <td>
                                    <form method="post" asp-page-handler="Remove">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row mt-4">
                <div class="col-md-8"></div>
                <div class="col-md-4">
                    <div class="card">
                        <div class="card-body">
                            <h5>Total: <span style="color: #D10024;">$@Model.Cart.Items.Sum(x => x.Price * x.Quantity).ToString("F2")</span></h5>
                            <form method="post" asp-page-handler="Checkout">
                                <button type="submit" class="primary-btn order-submit w-100 mt-3">Proceed to Checkout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                Your cart is empty. <a href="/Product/Products">Continue shopping</a>
            </div>
        }
    </div>
</div>
