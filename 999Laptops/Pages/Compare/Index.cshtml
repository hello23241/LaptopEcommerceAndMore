@model LaptopEcommerceAndMore.ViewModels.CompareViewModel

@{
    ViewData["Title"] = "Compare Products";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1 class="mb-4">Compare Products</h1>

    @if (TempData["CompareError"] != null)
    {
        <div class="alert alert-warning">@TempData["CompareError"]</div>
    }

    @if (Model.Products.Count == 0)
    {
        <div class="alert alert-info">No products to compare yet.</div>
        <a class="btn btn-secondary" href="@Url.Action("Index", "Product")">Back to Products</a>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Feature</th>
                        @foreach (var product in Model.Products)
                        {
                            <th>@product.ProductName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th>Price</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>$@product.BasePrice.ToString("F2")</td>
                        }
                    </tr>
                    <tr>
                        <th>Description</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.Description</td>
                        }
                    </tr>
                    <tr>
                        <th>CPU</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.CPU</td>
                        }
                    </tr>
                    <tr>
                        <th>RAM</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.RAM</td>
                        }
                    </tr>
                    <tr>
                        <th>GPU</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.GPU</td>
                        }
                    </tr>
                    <tr>
                        <th>HardDrive</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.Storage</td>
                        }
                    </tr>
                    <tr>
                        <th>Screen</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.Display</td>
                        }
                    </tr>
                    <tr>
                        <th>Weight</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.Weight</td>
                        }
                    </tr>
                    <tr>
                        <th>Extra</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.ProductDetails?.Extra</td>
                        }
                    </tr>
                    <tr>
                        <th>Category</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.CategoryID</td>
                        }
                    </tr>
                    <tr>
                        <th>Supplier</th>
                        @foreach (var product in Model.Products)
                        {
                            <td>@product.BrandID</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

