@page "{p:int?}"
@model LaptopEcommerceAndMore.Pages.Product.ProductsModel
@{
    ViewData["Title"] = "Products list";
    ViewData["ShowSidebar"] = false;
    Layout = "~/Pages/Shared/_Layout.cshtml";

    var currency = HttpContext.Session.GetString("Currency") ?? "USD";
    var isVnd = currency == "VND";
    var rate = isVnd ? Model.UsdToVndRate : 1m;

    string FormatCurrency(decimal amount)
    {
        if (isVnd)
        {
            if (amount >= 1000000m)
            {
                decimal millions = amount / 1000000m;
                return $"{millions:0.#}M VND";
            }
            else
            {
                decimal thousands = amount / 1000m;
                return $"{thousands:0.#}K VND";
            }
        }
        else
        {
            return $"${amount:N2}";
        }
    }
    
    // ĐA THÊM: Chuỗi gốc cố định trỏ đến miền chứa Blob của Azure Storage
    string azureBaseUrl = "https://laptopimages2026.blob.core.windows.net/product-images/";
    var productIndex = 0;
}

<style>
    .product-entrance {
        opacity: 0;
        transform: translateY(12px);
        animation: productFadeIn 0.5s ease-out forwards;
    }

    @@keyframes productFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .product-hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    .product-hover-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>

<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="mb-2">Products</h2>
                @if (!string.IsNullOrEmpty(Model.CategoryName) || !string.IsNullOrEmpty(Model.BrandName))
                {
                    <div class="mb-4" style="color: #8D99AE; font-weight: 600;">
                        Showing
                        @if (!string.IsNullOrEmpty(Model.CategoryName))
                        {
                            <span>category: <strong style="color: #1E1F29;">@Model.CategoryName</strong></span>
                        }
                        @if (!string.IsNullOrEmpty(Model.BrandName))
                        {
                            <span>@(!string.IsNullOrEmpty(Model.CategoryName) ? " | " : "")brand: <strong style="color: #1E1F29;">@Model.BrandName</strong></span>
                        }
                        <a asp-page="/Product/Products" class="ms-2" style="color: #D10024; font-weight: 700; text-decoration: none;">Clear</a>
                    </div>
                }
                else
                {
                    <div class="mb-4"></div>
                }
            </div>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.Products)
            {
                var animationDelay = (productIndex++) * 0.06m;
                <div class="col-12 col-sm-6 col-md-4">
                    <a asp-page="/Product/Product" asp-route-id="@product.ProductID" style="text-decoration: none; color: inherit;">
                        <div class="card h-100 style-product-card product-hover-card product-entrance" style="border: 1px solid #E4E7ED; border-radius: 6px; overflow: hidden; animation-delay: @animationDelay.ToString("0.00")s;">
                            <div class="card-body d-flex flex-column align-items-center p-3">
                                <div style="width: 100%; aspect-ratio: 1 / 1; background-color: #FBFBFC; border: 1px solid #E4E7ED; display: flex; align-items: center; justify-content: center;">
                                    @if (!string.IsNullOrEmpty(product.ProductImage))
                                    {
                                        <img src="@(azureBaseUrl + product.ProductImage)" alt="@product.ProductName" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                    }
                                    else
                                    {
                                        <span style="color: #8D99AE; font-weight: 600;">Image</span>
                                    }
                                </div>
                                <h5 class="mt-3 mb-2 text-center" style="font-size: 15px; height: 42px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                    @product.ProductName
                                </h5>
                                
                                <div style="color: #D10024; font-weight: 700; font-size: 16px;">
                                    @FormatCurrency(product.BasePrice * rate)
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <div class="row mt-4">
            <div class="col-12 d-flex justify-content-center gap-2">
    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
    {
        var buttonClass = pageNumber == Model.PageNumber ? "btn btn-danger text-white" : "btn btn-outline-danger text-danger";

        <a asp-page="/Product/Products"
           asp-route-p="@pageNumber"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-brandId="@Model.BrandId"
           class="@buttonClass"
           style="font-weight: 600; text-decoration: none;">
            @pageNumber
        </a>
    }
            </div>
        </div>
    </div>
</div>