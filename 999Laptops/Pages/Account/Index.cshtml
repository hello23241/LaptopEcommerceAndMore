@model List<LaptopEcommerceAndMore.Models.Users>

@{
    ViewData["Title"] = "Accounts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h1 class="mb-4">User Accounts</h1>
    
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">Add New Account</a>

    @if (Model.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model)
                {
                    <tr>
                        <td>@account.UserId</td>
                        <td>@account.Username</td>
                        <td>@account.FullName</td>
                        <td>@account.Email</td>
                        <td>@account.PhoneNumber</td>
                        <td>
                            @if (account.Role == "Customer")
                            {
                                <span class="badge bg-success">Customer</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Details", new { id = account.UserId })" class="btn btn-sm btn-info">View</a>
                            <a href="@Url.Action("Edit", new { id = account.UserId })" class="btn btn-sm btn-warning">Edit</a>
                            <a href="@Url.Action("Delete", new { id = account.UserId })" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">No accounts found.</div>
    }
</div>

