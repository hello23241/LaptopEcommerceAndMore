@page
@model LaptopEcommerceAndMore.Pages.Account.VerifyEmailModel
@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<style>
    .otp-wrapper {
        padding: 40px 0;
        background: #f9f9f9;
    }

    .otp-card {
        background: #fff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        text-align: center;
    }

    .otp-inputs {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 25px 0;
    }

    .otp-field {
        width: 45px;
        height: 55px;
        font-size: 24px;
        font-weight: bold;
        text-align: center;
        border: 2px solid #ddd;
        border-radius: 8px;
        transition: all 0.3s;
    }

        .otp-field:focus {
            border-color: #D10024;
            box-shadow: 0 0 8px rgba(209, 0, 36, 0.2);
            outline: none;
        }

    .primary-btn {
        width: 100%;
        font-weight: bold;
        letter-spacing: 1px;
    }

    /* Thêm style cho nút link g?i l?i */
    .resend-link {
        color: #D10024;
        font-weight: bold;
        background: none;
        border: none;
        padding: 0;
        text-decoration: underline;
        cursor: pointer;
    }

        .resend-link:disabled {
            color: #8D99AE;
            text-decoration: none;
            cursor: not-allowed;
        }
</style>

<div class="otp-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="otp-card">
                    <div class="section-title">
                        <h3 class="title">Xác th?c Email</h3>
                        
                        @if (Model.StatusMessage != null)
                        {
                            var mailStatus = TempData["MailStatus"]?.ToString();
                            var alertClass = mailStatus == "Success" ? "alert-success" : "alert-danger";
                            <div class="alert @alertClass" role="alert" style="margin-bottom: 20px; font-size: 14px;">
                                <i class="fa @(mailStatus == "Success" ? "fa-check-circle" : "fa-exclamation-triangle")"></i>
                                @Model.StatusMessage
                            </div>
                        }

                        <p class="text-muted">Mã OTP dã du?c g?i d?n hòm thu <br /><strong>@Model.Email</strong></p>
                    </div>

                    <form method="post" id="otpForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="OtpCode" id="hiddenOtp" />

                        <div class="otp-inputs">
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" autocomplete="one-time-code" required />
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" required />
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" required />
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" required />
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" required />
                            <input type="text" class="otp-field" maxlength="1" pattern="\d*" inputmode="numeric" required />
                        </div>

                        <button type="submit" class="primary-btn">XÁC NH?N TÀI KHO?N</button>
                    </form>

                    <div class="mt-4">
                        @if (Model.ShowResend)
                        {
                            <p class="text-muted">
                                Không nh?n du?c mã?
                                <form asp-page-handler="Resend" method="post" style="display:inline;">
                                    <input type="hidden" asp-for="Email" />
                                    <button type="submit" class="resend-link">G?i l?i ngay</button>
                                </form>
                            </p>
                        }
                        else
                        {
                            <p class="text-muted" style="font-size: 13px; font-style: italic;">
                                <i class="fa fa-clock-o"></i> Vui lòng d?i mã h?t h?n d? yêu c?u g?i l?i.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const fields = document.querySelectorAll('.otp-field');
        const hiddenInput = document.getElementById('hiddenOtp');

        fields.forEach((field, index) => {
            field.addEventListener('input', (e) => {
                if (e.target.value.length >= 1 && index < fields.length - 1) {
                    fields[index + 1].focus();
                }
                combineOtp();
            });

            field.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && field.value === '' && index > 0) {
                    fields[index - 1].focus();
                }
            });
        });

        function combineOtp() {
            let otp = "";
            fields.forEach(f => otp += f.value);
            hiddenInput.value = otp;
        }

        fields[0].addEventListener('paste', (e) => {
            const data = e.clipboardData.getData('text').split('');
            if (data.length === 6) {
                fields.forEach((f, i) => f.value = data[i]);
                combineOtp();
                fields[5].focus();
            }
        });
    </script>
}
